# Copy to .env and fill in real values. Never commit the real .env.
# Phase 1: these are the variables the foundation already depends on.
# Later phases will add more here as they need them (documented in
# each phase's report, not silently).

NODE_ENV=development
PORT=4000

# Phase 3 will create the actual database this points to.
DATABASE_URL=postgres://susupro_app:CHANGE_ME@localhost:5432/susupro_dev

# Used by Phase 6 (authentication) — generate a long random value.
JWT_SECRET=

# Phase 4's frontend origin, once it exists. Never leave this as "*"
# in production.
CORS_ORIGIN=http://localhost:5173

# Optional — SMS deposit notifications (customers pay GHS 0.20/message,
# opt-in only). The app works fully without these set; SMS just won't
# actually send until a real Arkesel account exists and is configured.
SMS_API_KEY=
SMS_SENDER_ID=SusuPro
